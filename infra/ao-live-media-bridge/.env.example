# Public WSS URL Twilio will connect to (also set in CRM Live Settings → Media Stream URL)
PORT=8787
HOST=0.0.0.0

# AO CRM site (used to resolve call tokens)
CRM_BASE_URL=https://your-site.example.com
# Must match CRM Live Settings → Webhook Secret
CRM_LIVE_WEBHOOK_SECRET=change-me

# Optional fallback if CRM resolve does not return a key
# OPENAI_API_KEY=sk-proj-...
